  // FUNÇÃO DE DEFINIÇÃO RÁPIDA DE EXEMPLOS
  function setGoal(text) {
    document.getElementById('goalInput').value = text;
    analyzeGoal();
  }

  function clearGoal() {
    document.getElementById('goalInput').value = '';
    document.getElementById('resultContainer').style.display = 'none';
  }

  // MOTOR DE INFERÊNCIA ANALÍTICA
  function analyzeGoal() {
    const rawInput = document.getElementById('goalInput').value.trim();
    if (!rawInput) {
      alert("Por favor, digite um objetivo de aprendizagem ou selecione uma das sugestões rápidas.");
      return;
    }

    const inputLower = rawInput.toLowerCase();
    let bestGame = null;
    let maxScore = -1;

    gamesDatabase.forEach(game => {
      let score = 0;
      game.keywords.forEach(kw => {
        if (inputLower.includes(kw)) {
          score += 3;
        }
      });

      // Bônus semântico cruzado por contexto
      if (inputLower.includes("orden") || inputLower.includes("sequên") || inputLower.includes("etapa") || inputLower.includes("fluxo")) {
        if (game.id === "ordem_classificacao") score += 5;
      }
      if (inputLower.includes("defin") || inputLower.includes("conceit") || inputLower.includes("term") || inputLower.includes("signific")) {
        if (game.id === "combine") score += 5;
      }
      if (inputLower.includes("anatom") || inputLower.includes("imagem") || inputLower.includes("mapa") || inputLower.includes("rotul") || inputLower.includes("localiz")) {
        if (game.id === "diagrama_rotulado") score += 6;
      }
      if (inputLower.includes("sorte") || inputLower.includes("roleta") || inputLower.includes("aleat") || inputLower.includes("tbl") || inputLower.includes("seminár")) {
        if (game.id === "sorteio_ativas") score += 6;
      }
      if (inputLower.includes("classific") || inputLower.includes("categor") || inputLower.includes("grupos") || inputLower.includes("triagem")) {
        if (game.id === "classificacao_grupo") score += 5;
      }
      if (inputLower.includes("frase") || inputLower.includes("lacuna") || inputLower.includes("complet") || inputLower.includes("laudo")) {
        if (game.id === "complete_frase") score += 5;
      }
      if (inputLower.includes("verdadeiro") || inputLower.includes("falso") || inputLower.includes("mito")) {
        if (game.id === "verdadeiro_falso") score += 6;
      }

      if (score > maxScore) {
        maxScore = score;
        bestGame = game;
      }
    });

    // Se nenhuma palavra-chave pontuou, fallback para o clássico Quiz ou Combine
    if (maxScore <= 0) {
      bestGame = gamesDatabase.find(g => g.id === "quiz");
    }

    renderResult(bestGame, rawInput);
  }

  // RENDERIZAÇÃO DO RESULTADO
  function renderResult(game, originalGoal) {
    const resBox = document.getElementById('resultContainer');
    document.getElementById('resCategory').innerText = game.catName;
    document.getElementById('resGameTitle').innerHTML = `${game.name} <span class="game-meta-badge">${game.pro ? 'Plano Pró / Padrão' : 'Plano Gratuito / Pró'}</span>`;
    document.getElementById('resDynamics').innerText = game.dynamics;
    document.getElementById('resCompetence').innerText = game.competence;

    // Justificativa baseada nas evidências
    const evidenceText = `O objetivo "${originalGoal.substring(0, 75)}..." é potencializado por este modelo porque, como demonstram Prensky (2012) e Saravali, Bessa e Lima (2025), a transferência da aprendizagem ocorre quando a mecânica do game espelha fielmente a competência pretendida. Recomenda-se realizar uma mediação docente ativa logo após a rodada com perguntas de reflexão (debriefing).`;
    document.getElementById('resEvidence').innerText = evidenceText;

    // Alternativas do mesmo grupo ou grupos correlatos
    const alternatives = gamesDatabase.filter(g => g.category === game.category && g.id !== game.id).slice(0, 3);
    const altContainer = document.getElementById('resAlternatives');
    
    if (alternatives.length > 0) {
      altContainer.innerHTML = alternatives.map(alt => `
        <div class="alt-card">
          <strong>${alt.name}</strong>
          <span>${alt.dynamics}</span>
        </div>
      `).join('');
    } else {
      altContainer.innerHTML = `<p style="font-size:0.8rem; color:#64748B;">Nenhuma alternativa direta no mesmo grupo.</p>`;
    }

    resBox.style.display = 'block';
    resBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  // FILTRO DO CATÁLOGO DE MODELOS
  function filterCatalog(category, btnElement) {
    const tabs = document.querySelectorAll('.tab-btn');
    tabs.forEach(t => t.classList.remove('active'));
    if (btnElement) btnElement.classList.add('active');

    const container = document.getElementById('catalogGrid');
    const filtered = category === 'all' ? gamesDatabase : gamesDatabase.filter(g => g.category === category);

    container.innerHTML = filtered.map(game => `
      <div class="catalog-item">
        <div class="catalog-top">
          <h4>${game.name} <span class="cat-pill">${game.pro ? 'Pró' : 'Grátis/Pró'}</span></h4>
          <p class="dyn"><strong>Dinâmica:</strong> ${game.dynamics}</p>
        </div>
        <div class="catalog-bottom">
          <p class="comp"><strong>Competência:</strong> ${game.competence}</p>
        </div>
      </div>
    `).join('');
  }

  // Inicialização do Catálogo Completo
  filterCatalog('all', document.querySelector('.tab-btn.active'));
