<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Guia de Escolha de Modelos do Wordwall por Objetivos de Aprendizagem • Profa. Dra. Andréa Soares Rocha da Silva</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Space+Grotesk:wght@600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --primary: #0F3D5E;
      --primary-dark: #09253B;
      --primary-light: #1A5B8C;
      --secondary: #0D9488;
      --secondary-light: #14B8A6;
      --secondary-soft: #F0FDFA;
      --accent: #EA580C;
      --accent-soft: #FFF7ED;
      --dark: #0F172A;
      --gray-light: #F8FAFC;
      --gray-border: #E2E8F0;
      --text-main: #334155;
      --text-muted: #64748B;
      --card-bg: #FFFFFF;
      --radius-sm: 8px;
      --radius-md: 14px;
      --radius-lg: 20px;
      --shadow-sm: 0 2px 4px rgba(15, 23, 42, 0.05);
      --shadow-md: 0 10px 25px -5px rgba(15, 23, 42, 0.08);
      --shadow-lg: 0 20px 35px -10px rgba(15, 23, 42, 0.12);
      --transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
      background-color: #F1F5F9;
      color: var(--text-main);
      line-height: 1.6;
      padding: 24px 16px;
      -webkit-font-smoothing: antialiased;
    }

    .container {
      max-width: 1180px;
      margin: 0 auto;
    }

    /* HEADER */
    .header-card {
      background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
      color: #FFFFFF;
      border-radius: var(--radius-lg);
      padding: 36px 32px;
      margin-bottom: 26px;
      box-shadow: var(--shadow-lg);
      position: relative;
      overflow: hidden;
    }

    .header-card::after {
      content: '';
      position: absolute;
      top: -30%;
      right: -8%;
      width: 420px;
      height: 420px;
      background: radial-gradient(circle, rgba(20, 184, 166, 0.24) 0%, transparent 70%);
      pointer-events: none;
    }

    .author-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: var(--secondary);
      color: #FFFFFF;
      font-size: 0.82rem;
      font-weight: 700;
      padding: 6px 14px;
      border-radius: 999px;
      margin-bottom: 16px;
      letter-spacing: 0.02em;
    }

    .title-group h1 {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 2.1rem;
      font-weight: 700;
      line-height: 1.25;
      margin-bottom: 12px;
      letter-spacing: -0.02em;
      color: #FFFFFF;
    }

    .title-group p.lead {
      font-size: 1.02rem;
      color: #CBD5E1;
      max-width: 900px;
      margin-bottom: 18px;
    }

    .evidence-summary {
      background: rgba(255, 255, 255, 0.08);
      border-left: 4px solid var(--secondary-light);
      padding: 12px 16px;
      border-radius: var(--radius-sm);
      font-size: 0.88rem;
      color: #E2E8F0;
    }

    /* SECTIONS */
    .section-card {
      background: var(--card-bg);
      border-radius: var(--radius-lg);
      padding: 30px;
      margin-bottom: 26px;
      box-shadow: var(--shadow-md);
      border: 1px solid var(--gray-border);
    }

    .section-title {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 1.35rem;
      font-weight: 700;
      color: var(--primary);
      margin-bottom: 8px;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .step-tag {
      background: var(--primary-light);
      color: #FFFFFF;
      font-size: 0.72rem;
      padding: 3px 10px;
      border-radius: 999px;
      font-weight: 700;
      text-transform: uppercase;
    }

    .section-desc {
      font-size: 0.9rem;
      color: var(--text-muted);
      margin-bottom: 22px;
    }

    /* INTERACTIVE ANALYZER */
    .input-box-wrapper {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .goal-input {
      width: 100%;
      min-height: 90px;
      padding: 14px 16px;
      border: 2px solid var(--gray-border);
      border-radius: var(--radius-md);
      font-family: inherit;
      font-size: 0.98rem;
      color: var(--dark);
      resize: vertical;
      transition: var(--transition);
      line-height: 1.5;
    }

    .goal-input:focus {
      outline: none;
      border-color: var(--secondary);
      box-shadow: 0 0 0 3px rgba(13, 148, 136, 0.15);
    }

    .examples-wrapper {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 8px;
      margin-top: 6px;
    }

    .examples-label {
      font-size: 0.78rem;
      font-weight: 600;
      color: var(--text-muted);
      text-transform: uppercase;
    }

    .example-chip {
      background: #F1F5F9;
      border: 1px solid var(--gray-border);
      border-radius: 999px;
      padding: 5px 12px;
      font-size: 0.78rem;
      color: var(--primary-light);
      cursor: pointer;
      transition: var(--transition);
    }

    .example-chip:hover {
      background: var(--secondary-soft);
      border-color: var(--secondary-light);
      color: var(--secondary);
    }

    .action-btn-row {
      display: flex;
      justify-content: flex-end;
      gap: 10px;
      margin-top: 14px;
    }

    .btn-analyze {
      background: var(--secondary);
      color: #FFFFFF;
      border: none;
      border-radius: var(--radius-sm);
      padding: 12px 24px;
      font-weight: 700;
      font-size: 0.95rem;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      transition: var(--transition);
    }

    .btn-analyze:hover {
      background: #0F766E;
      transform: translateY(-2px);
      box-shadow: var(--shadow-sm);
    }

    .btn-clear {
      background: #F1F5F9;
      color: var(--text-muted);
      border: 1px solid var(--gray-border);
      border-radius: var(--radius-sm);
      padding: 12px 18px;
      font-weight: 600;
      font-size: 0.9rem;
      cursor: pointer;
      transition: var(--transition);
    }

    .btn-clear:hover {
      background: #E2E8F0;
      color: var(--dark);
    }

    /* RESULT CARD */
    .result-container {
      margin-top: 28px;
      display: none;
      animation: fadeIn 0.3s ease-in-out;
    }

    .result-card {
      background: #FFFFFF;
      border-radius: var(--radius-md);
      border: 2px solid var(--secondary);
      box-shadow: var(--shadow-md);
      overflow: hidden;
    }

    .result-header {
      background: var(--secondary-soft);
      padding: 18px 24px;
      border-bottom: 1px solid #CCFBF1;
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
    }

    .result-badge-cat {
      background: var(--secondary);
      color: #FFF;
      font-size: 0.78rem;
      font-weight: 700;
      padding: 4px 12px;
      border-radius: 999px;
      text-transform: uppercase;
      letter-spacing: 0.03em;
    }

    .result-match-rate {
      font-size: 0.84rem;
      font-weight: 700;
      color: #0F766E;
    }

    .result-body {
      padding: 24px;
    }

    .primary-recommendation {
      display: flex;
      flex-direction: column;
      gap: 6px;
      margin-bottom: 20px;
    }

    .primary-recommendation h3 {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 1.5rem;
      color: var(--primary);
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .game-meta-badge {
      background: #EFF6FF;
      color: #1D4ED8;
      border: 1px solid #BFDBFE;
      font-size: 0.72rem;
      font-weight: 700;
      padding: 2px 8px;
      border-radius: 6px;
    }

    .result-grid-cols {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 18px;
      margin-top: 16px;
    }

    .detail-box-card {
      background: var(--gray-light);
      border: 1px solid var(--gray-border);
      border-radius: var(--radius-sm);
      padding: 16px;
    }

    .detail-box-card h4 {
      font-size: 0.88rem;
      color: var(--primary-light);
      font-weight: 700;
      margin-bottom: 6px;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .detail-box-card p {
      font-size: 0.84rem;
      color: var(--text-main);
      line-height: 1.45;
    }

    .alternatives-container {
      margin-top: 22px;
      border-top: 1px dashed var(--gray-border);
      padding-top: 18px;
    }

    .alternatives-container h4 {
      font-size: 0.95rem;
      color: var(--primary);
      font-weight: 700;
      margin-bottom: 12px;
    }

    .alt-cards-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 12px;
    }

    .alt-card {
      background: #FFFFFF;
      border: 1px solid var(--gray-border);
      border-radius: var(--radius-sm);
      padding: 12px 14px;
      transition: var(--transition);
    }

    .alt-card:hover {
      border-color: var(--secondary-light);
      box-shadow: var(--shadow-sm);
      transform: translateY(-2px);
    }

    .alt-card strong {
      display: block;
      font-size: 0.88rem;
      color: var(--primary);
      margin-bottom: 4px;
    }

    .alt-card span {
      font-size: 0.78rem;
      color: var(--text-muted);
      line-height: 1.35;
      display: block;
    }

    /* MATRIZ PEDAGÓGICA NAVEGÁVEL */
    .filter-tabs {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 20px;
    }

    .tab-btn {
      background: #F1F5F9;
      border: 1px solid var(--gray-border);
      border-radius: 999px;
      padding: 8px 16px;
      font-size: 0.82rem;
      font-weight: 600;
      color: var(--text-main);
      cursor: pointer;
      transition: var(--transition);
    }

    .tab-btn:hover {
      background: #E2E8F0;
      color: var(--primary);
    }

    .tab-btn.active {
      background: var(--primary);
      color: #FFFFFF;
      border-color: var(--primary);
    }

    .catalog-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 16px;
    }

    .catalog-item {
      background: #FFFFFF;
      border: 1px solid var(--gray-border);
      border-radius: var(--radius-md);
      padding: 16px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      transition: var(--transition);
    }

    .catalog-item:hover {
      border-color: var(--secondary-light);
      box-shadow: var(--shadow-md);
      transform: translateY(-3px);
    }

    .catalog-top h4 {
      font-size: 1rem;
      color: var(--primary);
      margin-bottom: 6px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .catalog-top .cat-pill {
      font-size: 0.68rem;
      padding: 2px 8px;
      border-radius: 4px;
      background: #F1F5F9;
      color: var(--text-muted);
      font-weight: 600;
    }

    .catalog-top p.dyn {
      font-size: 0.8rem;
      color: #475569;
      margin-bottom: 10px;
    }

    .catalog-bottom {
      border-top: 1px dashed var(--gray-border);
      padding-top: 10px;
      margin-top: 10px;
    }

    .catalog-bottom p.comp {
      font-size: 0.78rem;
      color: var(--secondary);
      font-weight: 600;
    }

    /* FOOTER & CRÉDITOS */
    .footer-card {
      background: #0B1E2E;
      color: #94A3B8;
      border-radius: var(--radius-lg);
      padding: 34px 30px;
      font-size: 0.85rem;
      border: 1px solid rgba(255, 255, 255, 0.06);
    }

    .footer-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 24px;
      margin-bottom: 24px;
    }

    .footer-col h5 {
      color: #FFFFFF;
      font-size: 0.92rem;
      margin-bottom: 10px;
      font-family: 'Space Grotesk', sans-serif;
    }

    .footer-col p, .footer-col li {
      font-size: 0.82rem;
      color: #CBD5E1;
      margin-bottom: 5px;
    }

    .footer-col ul {
      list-style: none;
      padding: 0;
    }

    .references-section {
      border-top: 1px solid rgba(255, 255, 255, 0.12);
      padding-top: 22px;
      margin-top: 18px;
    }

    .references-header {
      color: #F8FAFC;
      font-size: 0.96rem;
      font-weight: 700;
      margin-bottom: 12px;
      font-family: 'Space Grotesk', sans-serif;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .ref-list {
      list-style: none;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .ref-item {
      font-size: 0.8rem;
      color: #CBD5E1;
      line-height: 1.45;
      padding-left: 14px;
      text-indent: -14px;
    }

    .copyright-section {
      border-top: 1px solid rgba(255, 255, 255, 0.12);
      padding-top: 20px;
      margin-top: 22px;
    }

    .copyright-header {
      color: #F8FAFC;
      font-size: 0.92rem;
      font-weight: 700;
      margin-bottom: 8px;
      font-family: 'Space Grotesk', sans-serif;
    }

    .copyright-text {
      color: #94A3B8;
      font-size: 0.82rem;
      line-height: 1.55;
      margin-bottom: 16px;
      text-align: justify;
    }

    .citation-box {
      background: rgba(255, 255, 255, 0.04);
      border: 1px dashed rgba(255, 255, 255, 0.2);
      border-radius: var(--radius-sm);
      padding: 14px 16px;
      margin-bottom: 18px;
    }

    .citation-title {
      font-weight: 700;
      color: var(--secondary-light);
      font-size: 0.78rem;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      margin-bottom: 6px;
    }

    .citation-code {
      font-family: monospace, monospace;
      font-size: 0.82rem;
      color: #E2E8F0;
      word-break: break-all;
      line-height: 1.45;
    }

    .footer-bottom {
      border-top: 1px solid rgba(255, 255, 255, 0.08);
      padding-top: 14px;
      text-align: center;
      font-size: 0.78rem;
      color: #64748B;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(6px); }
      to { opacity: 1; transform: translateY(0); }
    }

    @media (max-width: 768px) {
      .header-card { padding: 24px 20px; }
      .title-group h1 { font-size: 1.6rem; }
      .section-card { padding: 20px; }
      .action-btn-row { flex-direction: column; }
      .btn-analyze, .btn-clear { width: 100%; justify-content: center; }
    }
  </style>
</head>
<body>

<div class="container">

  <!-- CABEÇALHO COM AUTORIA -->
  <header class="header-card">
    <div class="author-badge">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
      Autoria: Profa. Dra. Andréa Soares Rocha da Silva
    </div>

    <div class="title-group">
      <h1>Guia Interativo de Escolha de Jogos no Wordwall</h1>
      <p class="lead">Ferramenta analítica de design instrucional para seleção e alinhamento de modelos de games da plataforma Wordwall.net aos objetivos pedagógicos e competências de aprendizagem (Silva, 2026).</p>
    </div>

    <div class="evidence-summary">
      <strong>Fundamentação teórica:</strong> O jogo digital não produz resultados por si só; sua eficácia decorre do alinhamento explícito ao objetivo de aprendizagem, da mediação docente estruturada e do equilíbrio entre desafio cognitivo e engajamento (Saravali; Bessa; Lima, 2025; Prensky, 2012; Tsutsumi et al., 2020).
    </div>
  </header>

  <!-- SEÇÃO 1: ANALISADOR INTERATIVO -->
  <section class="section-card">
    <h2 class="section-title">
      <span class="step-tag">Etapa 1</span>
      Analisador Inteligente por Objetivo de Aprendizagem
    </h2>
    <p class="section-desc">Digite abaixo o que você deseja que os estudantes aprendam ou desenvolvam (ex.: verbos de ação, conceitos, sequências ou atitudes). O motor analisará a semântica pedagógica e indicará o modelo ideal no Wordwall:</p>

    <div class="input-box-wrapper">
      <textarea id="goalInput" class="goal-input" placeholder="Exemplo: Identificar e diferenciar as estruturas anatômicas do sistema circulatório em uma imagem clínica..."></textarea>
      
      <div class="examples-wrapper">
        <span class="examples-label">Sugestões rápidas:</span>
        <button type="button" class="example-chip" onclick="setGoal('Diferenciar termos técnicos associando cada conceito à sua respectiva definição oficial.')">Conceitos e Termos</button>
        <button type="button" class="example-chip" onclick="setGoal('Ordenar cronologicamente as etapas do protocolo operacional de emergência.')">Sequência Operacional</button>
        <button type="button" class="example-chip" onclick="setGoal('Localizar e rotular os componentes de um maquinário em um mapa esquemático.')">Localização Visual</button>
        <button type="button" class="example-chip" onclick="setGoal('Avaliar criticamente a veracidade de condutas clínicas sob pressão de tempo.')">Tomada de Decisão Rápida</button>
        <button type="button" class="example-chip" onclick="setGoal('Dinamizar a aula com sorteio aleatório de estudos de caso para debate em grupo.')">Sorteio e Metodologia Ativa</button>
        <button type="button" class="example-chip" onclick="setGoal('Estimular a memorização ortográfica e fixação de novos jargões técnicos da área.')">Vocabulário Técnico</button>
      </div>

      <div class="action-btn-row">
        <button type="button" class="btn-clear" onclick="clearGoal()">Limpar</button>
        <button type="button" class="btn-analyze" onclick="analyzeGoal()">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
          Analisar Objetivo e Indicar Game
        </button>
      </div>
    </div>

    <!-- RESULTADO DO ANALISADOR -->
    <div id="resultContainer" class="result-container">
      <div class="result-card">
        <div class="result-header">
          <span class="result-badge-cat" id="resCategory">Categoria</span>
          <span class="result-match-rate" id="resMatchScore">Alinhamento Pedagógico Alto</span>
        </div>
        <div class="result-body">
          <div class="primary-recommendation">
            <span style="font-size: 0.8rem; font-weight: 700; color: var(--text-muted); text-transform: uppercase;">Modelo Mais Recomendado no Wordwall</span>
            <h3 id="resGameTitle">
              Nome do Modelo
              <span class="game-meta-badge" id="resGameType">Wordwall Standard / Pro</span>
            </h3>
          </div>

          <div class="result-grid-cols">
            <div class="detail-box-card">
              <h4>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polygon points="10 8 16 12 10 16 10 8"></polygon></svg>
                Dinâmica de Interação no Wordwall
              </h4>
              <p id="resDynamics">Descrição da dinâmica interativa.</p>
            </div>

            <div class="detail-box-card">
              <h4>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                Competência Pedagógica Desenvolvida
              </h4>
              <p id="resCompetence">Competência promovida segundo o referencial.</p>
            </div>

            <div class="detail-box-card">
              <h4>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
                Fundamentação & Mediação Docente
              </h4>
              <p id="resEvidence">Orientações de mediação e evidência científica.</p>
            </div>
          </div>

          <!-- ALTERNATIVAS DO MESMO GRUPO -->
          <div class="alternatives-container">
            <h4>Outras Boas Opções para este mesmo Objetivo</h4>
            <div class="alt-cards-grid" id="resAlternatives">
              <!-- Injetado dinamicamente -->
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SEÇÃO 2: CATÁLOGO GERAL DOS 25 MODELOS POR COMPETÊNCIA -->
  <section class="section-card">
    <h2 class="section-title">
      <span class="step-tag">Etapa 2</span>
      Catálogo Geral de Modelos do Wordwall por Natureza Pedagógica
    </h2>
    <p class="section-desc">Filtre e explore todos os 25 modelos do Wordwall agrupados conforme a matriz pedagógica do documento de referência:</p>

    <div class="filter-tabs">
      <button type="button" class="tab-btn active" onclick="filterCatalog('all', this)">Todos os Modelos (25)</button>
      <button type="button" class="tab-btn" onclick="filterCatalog('associacao', this)">1. Associação & Classificação</button>
      <button type="button" class="tab-btn" onclick="filterCatalog('avaliacao', this)">2. Avaliação & Decisão</button>
      <button type="button" class="tab-btn" onclick="filterCatalog('espacial', this)">3. Espaciais & Visuais</button>
      <button type="button" class="tab-btn" onclick="filterCatalog('linguagem', this)">4. Linguagem & Escrita</button>
